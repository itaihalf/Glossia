# Supabase — get these from your project's Settings > API page
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI — used by netlify/functions/generate.js for story generation and word
# normalisation. NOT prefixed with VITE_: it must stay server-side only and is
# read via process.env, never bundled into the frontend. Set this in the
# Netlify dashboard (or a local .env for `netlify dev`).
OPENAI_API_KEY=your-openai-api-key-here
